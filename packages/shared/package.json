{
  "name": "@fatturafacile/shared",
  "version": "1.0.0",
  "description": "Shared cross-cutting utilities, telemetry, crypto, and SDK wrappers for FatturaFacile",
  "license": "MIT",
  "author": "FatturaFacile Team",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-utils": {
      "types": "./src/test-utils/index.ts",
      "import": "./src/test-utils/index.ts",
      "default": "./src/test-utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fatturafacile/openapi-sdk": "workspace:*"
  },
  "devDependencies": {
    "@fatturafacile/tsconfig": "workspace:*",
    "@fatturafacile/vitest-config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
