{
  "name": "@fatturafacile/integration-stripe",
  "description": "Production Stripe payments, payment intents, and reconciliation integration for FatturaFacile ERP",
  "version": "1.0.0",
  "author": "FatturaFacile Team",
  "license": "MIT",
  "category": "payments",
  "tier": 1,
  "dependencies": {
    "@fatturafacile/framework": "workspace:*",
    "@fatturafacile/shared": "workspace:*"
  },
  "permissions": [
    "invoices:read",
    "invoices:write",
    "payments:read",
    "payments:write",
    "webhooks:manage"
