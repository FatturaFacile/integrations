{
  "name": "@fatturafacile/integration-woocommerce",
  "description": "Production-grade WooCommerce e-commerce bidirectional synchronization for FatturaFacile ERP",
  "version": "1.0.0",
  "author": "FatturaFacile Team",
  "license": "MIT",
  "category": "ecommerce",
  "tier": 1,
  "dependencies": {
    "@fatturafacile/framework": "workspace:*",
    "@fatturafacile/shared": "workspace:*"
  },
  "permissions": [
    "invoices:read",
    "invoices:write",
    "customers:read",
    "customers:write",
    "products:read",
    "products:write",
    "webhooks:manage"
  ],
  "supportedErpVersion": ">=2.0.0",
  "supportedPlatforms": ["node>=20"]
}
