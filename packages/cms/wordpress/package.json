{
  "name": "@fatturafacile/integration-wordpress",
  "version": "1.0.0",
  "description": "Production WordPress CMS customer portal, ERP widgets, and invoice download integration for FatturaFacile ERP",
  "license": "MIT",
  "author": "FatturaFacile Team",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fatturafacile/framework": "workspace:*",
    "@fatturafacile/openapi-sdk": "workspace:*",
    "@fatturafacile/shared": "workspace:*"
  },
  "devDependencies": {
    "@fatturafacile/tsconfig": "workspace:*",
    "@fatturafacile/vitest-config": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
