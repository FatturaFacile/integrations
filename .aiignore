# Ignore list shared by every AI tool of this repository (gitignore syntax).
# Kept identical across: .aiignore, .claudeignore, .agyignore, .copilotignore

# Dependencies, build output and caches
node_modules/
.pnpm-store/
.turbo/
dist/
build/
.next/
.nuxt/
coverage/
.vitest/
playwright-report/
test-results/
blob-report/
.angular/
out-tsc/
tmp/
temp/

# Lockfiles and dependency manifests (token sinks)
pnpm-lock.yaml
package-lock.json
yarn.lock
composer.lock

# Environment configurations and secrets (never read or leak)
.env
.env.*
!.env.example
auth.json
certs/
*.pem
*.key
*.pfx
*.cert
*.crt

# Database and local state
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs and OS files
.idea/
.vs/
.history/
.DS_Store
Thumbs.db

# Generated binary and media files (token sinks)
*.min.js
*.min.css
*.map
*.css.map
*.pdf
*.zip
*.tar.gz
*.tgz
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.webp
*.avif
*.mp4
*.webm

# Ephemeral scratch & sandboxes
.sandbox/
*.tmp
